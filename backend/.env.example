DATABASE_URL=postgresql://embi:embi@postgres:5432/embi

# Local development uses MinIO (S3-compatible). For production, leave
# AWS_S3_ENDPOINT_URL unset and use real AWS credentials + region.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=embi-print
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRINTFUL_API_KEY=your_printful_key

# Leave SENDGRID_API_KEY empty in dev — emails are logged to stdout.
SENDGRID_API_KEY=

FRONTEND_URL=http://localhost:3000
